## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.csproj.user

# ReSharper / Rider
.idea/
*.DotSettings.user
_ReSharper*/

# NuGet
*.nupkg
packages/
*.nuget.props
*.nuget.targets

# Test results
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# Local secrets / configs
appsettings.local.json
secrets.json
*.env
Resources/*.local.json

# OS files
Thumbs.db
.DS_Store

# Temp / cache
*.tmp
*.cache
*.log
